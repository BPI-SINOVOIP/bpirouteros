# Strict mwan3 service-start reader.  Input is `uci -q export mwan3`; success
# means either the exact product-empty semantic state or one complete state
# generated by the v1.5 renderer.  Anything partial or foreign exits non-zero.

function bad() { invalid = 1; exit 1 }
function uq(v) {
	if (v !~ /^'[^']*'$/) bad()
	return substr(v, 2, length(v) - 2)
}
function add_key(s, k) {
	if (has[s SUBSEP k]) bad()
	has[s SUBSEP k] = 1
	key_count[s]++
}
function exact_keys(s, words,    a,n,i) {
	n = split(words, a, " ")
	if (key_count[s] != n) return 0
	for (i = 1; i <= n; i++) if (!has[s SUBSEP a[i]]) return 0
	return 1
}
function positive(v, max) {
	return v ~ /^[1-9][0-9]*$/ && (v + 0) >= 1 && (v + 0) <= max && sprintf("%d", v + 0) == v
}
function canonical_ipv4(v,    a,n,i) {
	n = split(v, a, ".")
	if (n != 4) return 0
	for (i = 1; i <= 4; i++) {
		if (a[i] !~ /^[0-9]+$/ || (length(a[i]) > 1 && substr(a[i],1,1) == "0") || a[i] + 0 > 255)
			return 0
	}
	return 1
}

{
	line = $0
	gsub(/^[ \t]+|[ \t]+$/, "", line)
	if (line == "") next
	n = split(line, f, /[ \t]+/)
	if (!saw_package) {
		if (n != 2 || f[1] != "package") bad()
		pkg = f[2]
		if (pkg ~ /^'/) pkg = uq(pkg)
		if (pkg != "mwan3") bad()
		saw_package = 1
		next
	}
	if (f[1] == "config") {
		if (n != 3) bad()
		type = f[2]
		name = uq(f[3])
		if (type !~ /^(globals|interface|member|policy|rule)$/ ||
		    name !~ /^[A-Za-z_][A-Za-z0-9_]*$/ || section_type[name] != "") bad()
		section_type[name] = type
		section_order[++section_count] = name
		current = name
		next
	}
	if (f[1] != "option" && f[1] != "list") bad()
	if (current == "" || n != 3 || f[2] !~ /^[A-Za-z_][A-Za-z0-9_]*$/) bad()
	key = f[2]
	value = uq(f[3])
	if (f[1] == "option") {
		if (has[current SUBSEP key]) bad()
		add_key(current, key)
		value_of[current SUBSEP key] = value
	} else {
		if (value_of[current SUBSEP key] != "") bad()
		if (!has[current SUBSEP key]) add_key(current, key)
		list_key = current SUBSEP key
		list_count[list_key]++
		list_of[list_key SUBSEP list_count[list_key]] = value
	}
}

END {
	if (invalid || !saw_package || section_count < 1) exit 1
	if (section_type["globals"] != "globals" ||
	    !exact_keys("globals", "mmx_mask bpir_managed") ||
	    value_of["globals" SUBSEP "mmx_mask"] != "0x3F00" ||
	    value_of["globals" SUBSEP "bpir_managed"] != "1") exit 1
	if (section_count == 1) exit 0

	if (section_type["bpi_policy"] != "policy" || section_type["bpi_default"] != "rule") exit 1
	mode = value_of["bpi_policy" SUBSEP "bpi_mode"]
	if (mode != "failover" && mode != "loadbalance") exit 1
	policy_keys = list_count["bpi_policy" SUBSEP "use_member"] > 0 ?
		"use_member last_resort bpi_mode" : "last_resort bpi_mode"
	if (!exact_keys("bpi_policy", policy_keys) ||
	    value_of["bpi_policy" SUBSEP "last_resort"] != "unreachable") exit 1
	if (!exact_keys("bpi_default", "dest_ip use_policy family") ||
	    value_of["bpi_default" SUBSEP "dest_ip"] != "0.0.0.0/0" ||
	    value_of["bpi_default" SUBSEP "use_policy"] != "bpi_policy" ||
	    value_of["bpi_default" SUBSEP "family"] != "ipv4") exit 1

	for (i = 1; i <= section_count; i++) {
		s = section_order[i]
		if (section_type[s] == "interface") interfaces[++interface_count] = s
		else if (section_type[s] == "member") members[++member_count] = s
		else if (s != "globals" && s != "bpi_policy" && s != "bpi_default") exit 1
	}
	if (interface_count < 1 || member_count != interface_count || section_count != 3 + 2 * interface_count) exit 1

	for (i = 1; i <= member_count; i++) {
		s = members[i]
		managed = value_of[s SUBSEP "bpir_managed"]
		want = managed == "1" ? "interface metric weight bpir_managed" : "interface metric weight"
		if ((managed != "" && managed != "1") || !exact_keys(s, want)) exit 1
		iface = value_of[s SUBSEP "interface"]
		metric = value_of[s SUBSEP "metric"]
		weight = value_of[s SUBSEP "weight"]
		if (iface !~ /^[A-Za-z_][A-Za-z0-9_]*$/ || !positive(metric, 255) || !positive(weight, 1000) || member_ref[iface] != "") exit 1
		if (mode == "loadbalance" && metric != "1") exit 1
		long_name = iface "_m" metric "_w" weight
		short_name = iface "_m" metric
		if (s != long_name && !(managed == "1" && weight == "1" && s == short_name)) exit 1
		member_ref[iface] = s
		member_metric[iface] = metric
		member_weight[iface] = weight
	}

	for (i = 1; i <= interface_count; i++) {
		s = interfaces[i]
		managed = value_of[s SUBSEP "bpir_managed"]
		want = "enabled family track_ip track_method reliability count timeout interval down up"
		if (managed == "1") want = want " bpir_managed"
		if ((managed != "" && managed != "1") || !exact_keys(s, want)) exit 1
		enabled = value_of[s SUBSEP "enabled"]
		if ((enabled != "0" && enabled != "1") ||
		    value_of[s SUBSEP "family"] != "ipv4" ||
		    value_of[s SUBSEP "track_method"] != "ping" ||
		    value_of[s SUBSEP "reliability"] != "1" || value_of[s SUBSEP "count"] != "1" ||
		    !positive(value_of[s SUBSEP "timeout"], 60) ||
		    !positive(value_of[s SUBSEP "interval"], 3600) ||
		    !positive(value_of[s SUBSEP "down"], 100) ||
		    !positive(value_of[s SUBSEP "up"], 100)) exit 1
		nip = list_count[s SUBSEP "track_ip"]
		if (nip < 1 || nip > 8 || member_ref[s] == "") exit 1
		delete seen_ip
		for (j = 1; j <= nip; j++) {
			ip = list_of[s SUBSEP "track_ip" SUBSEP j]
			if (!canonical_ipv4(ip) || seen_ip[ip]++) exit 1
		}
		if (enabled == "1") {
			want_use[++want_use_count] = member_ref[s]
			if (mode == "failover" && seen_metric[member_metric[s]]++) exit 1
		}
	}
	if (want_use_count == 0) exit 1
	got_use_count = list_count["bpi_policy" SUBSEP "use_member"]
	if (got_use_count != want_use_count) exit 1
	for (i = 1; i <= want_use_count; i++)
		if (list_of["bpi_policy" SUBSEP "use_member" SUBSEP i] != want_use[i]) exit 1
	exit 0
}
