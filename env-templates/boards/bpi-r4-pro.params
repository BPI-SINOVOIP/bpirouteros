# bpi-r4-pro (BPI-R4 Pro 8X) u-boot defenv params.
# Same MT7988A SoC as r4 -> reuses ../soc/mt7988.params. A new board = new params
# + vendored pristine; no template edits.
SOC_ENV=mt7988                                              # ../soc/mt7988.params (LOADADDR/BOOTARGS_BASE/NAND geom)
DTBBASE=mt7988a-bananapi-bpi-r4-pro-8x                      # config-/overlay base (dash form)
IMGPREFIX=openwrt-mediatek-filogic-bananapi_bpi-r4-pro-8x   # bootfile prefix (underscore form)
DEFENV_BASE=bananapi_bpi-r4-pro-8x                          # defenvs/<DEFENV_BASE>_<medium>_env
MEDIA="emmc sdmmc snand"                                    # media this board generates
BOOTLED_PWR=act                                    # u-boot LED label (PCA9555 LED not wired yet; non-fatal)
BOOTLED_REC=err                                     # u-boot LED label (non-fatal warning if absent)
BOOTCONF_EXTRA=                                             # no extra DT overlay
# err/act system LEDs (pca9555). Writing flash = both on; fault = err on.
LED_WRITING='led act on ; led err on ; '   # prepend: lit while writing NAND/eMMC
PROV_DONE=' ; if test $? = 0 ; then led act off ; led err off ; else led act off ; led err on ; fi'  # success: both off; fail: err red
LED_FAULT='led err on ; '                  # prepend: A/B fallback fault -> err
# Combo media: each combo's SFP overlay is appended to the copper base config.
# Read only this medium's environment. Derived values are recomputed before
# each bootm; never saveenv or rewrite the user's selectors during boot.
BOOTM_PREPARE='run r4pro_8x_select_media && '
EXTRA_ENV='r4pro_8x_select_media=setenv bootconf config-mt7988a-bananapi-bpi-r4-pro-8x ; run r4pro_8x_select_wan ; run r4pro_8x_select_lan ; echo "SKU=bpi-r4-pro-8x wan=[$r4pro_8x_wan_media] selected=$r4pro_8x_wan_selected lan=[$r4pro_8x_lan_media] selected=$r4pro_8x_lan_selected bootconf=$bootconf"
r4pro_8x_select_wan=if test "$r4pro_8x_wan_media" = sfp ; then setenv r4pro_8x_wan_selected sfp ; setenv bootconf $bootconf#mt7988a-bananapi-bpi-r4-pro-8x-wan-sfp ; else setenv r4pro_8x_wan_selected copper ; if test -n "$r4pro_8x_wan_media" && test "$r4pro_8x_wan_media" != copper ; then echo "WARNING: invalid r4pro_8x_wan_media; using copper" ; fi ; fi
r4pro_8x_select_lan=if test "$r4pro_8x_lan_media" = sfp ; then setenv r4pro_8x_lan_selected sfp ; setenv bootconf $bootconf#mt7988a-bananapi-bpi-r4-pro-8x-lan-sfp ; else setenv r4pro_8x_lan_selected copper ; if test -n "$r4pro_8x_lan_media" && test "$r4pro_8x_lan_media" != copper ; then echo "WARNING: invalid r4pro_8x_lan_media; using copper" ; fi ; fi
preboot=run r4pro_8x_select_media'
