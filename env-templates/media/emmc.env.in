ipaddr=10.1.1.3
serverip=10.1.1.1
loadaddr=@LOADADDR@
bootargs=@BOOTARGS_BASE@ panic=3
bootconf=config-@DTBBASE@
bootconf_base=config-@DTBBASE@
bootconf_emmc=@DTBBASE@-emmc
bootconf_extra=@BOOTCONF_EXTRA@
bootdelay=1
bootfile_bl2=@IMGPREFIX@-emmc-preloader.bin
bootfile_fip=@IMGPREFIX@-emmc-bl31-uboot.fip
bootfile=@IMGPREFIX@-squashfs-sysupgrade.itb
bootled_pwr=@BOOTLED_PWR@
bootled_rec=@BOOTLED_REC@
boot_production=led $bootled_pwr on ; run emmc_read_production && @BOOTM_PREPARE@bootm $loadaddr#$bootconf#$bootconf_emmc#$bootconf_extra ; led $bootled_pwr off
boot_emmc=run boot_production
boot_tftp_production=tftpboot $loadaddr $bootfile && iminfo $loadaddr && run emmc_write_production ; if env exists noboot ; then else @BOOTM_PREPARE@bootm $loadaddr#$bootconf#$bootconf_emmc#$bootconf_extra ; fi
boot_tftp_write_fip=tftpboot $loadaddr $bootfile_fip && run emmc_write_fip
boot_tftp_write_bl2=tftpboot $loadaddr $bootfile_bl2 && run emmc_write_bl2
boot_tftp=tftpboot $loadaddr $bootfile && @BOOTM_PREPARE@bootm $loadaddr#$bootconf
mmc_write_vol=imszb $loadaddr image_size && test 0x$image_size -le 0x$part_size && mmc erase 0x$part_addr 0x$part_size && mmc write $loadaddr 0x$part_addr 0x$image_size
mmc_read_vol=mmc read $loadaddr $part_addr 0x100 && imszb $loadaddr image_size && test 0x$image_size -le 0x$part_size && mmc read $loadaddr 0x$part_addr 0x$image_size && setexpr filesize $image_size * 0x200
part_default=production
reset_factory=eraseenv && reset
emmc_read_production=part start mmc 0 $part_default part_addr && part size mmc 0 $part_default part_size && run mmc_read_vol
emmc_write_bl2=mmc partconf 0 1 1 1 && mmc erase 0x0 0x400 && mmc write $fileaddr 0x0 0x400 ; mmc partconf 0 1 1 0
emmc_write_fip=mmc erase 0x3400 0x2000 && mmc write $fileaddr 0x3400 0x2000 && mmc erase 0x2000 0x800
emmc_write_production=part start mmc 0 $part_default part_addr && part size mmc 0 $part_default part_size && run mmc_write_vol
_init_env=setenv _init_env ; setenv _create_env ; saveenv ; saveenv
bootcmd=if button reset ; then run golden_restore ; fi ; run ab_seed ; run ab_setpart ; run boot_emmc ; echo "*** boot failed - rebooting ***" ; reset
active_slot=a
altcount=0
bootlimit=3
ab_seed=if test "$envset" != 1 ; then setenv envset 1 ; saveenv ; fi
ab_setpart=if test "$active_slot" = b ; then setenv part_default production_b ; else setenv part_default production ; fi
ab_verify_rollback=env load && test "$active_slot" = "$ab_expected_slot" && test "$altcount" = "$ab_expected_altcount" && test -z "$cfg_pending" && test "$upgrade_available" = 0 && test "$bootcount" = 0
altbootcmd=@LED_FAULT@if button reset ; then run golden_restore ; fi ; if test "$altcount" -ge 4 ; then echo "*** A/B exhausted - halting ***" ; setenv ab_expected_slot $active_slot ; setenv ab_expected_altcount $altcount ; setenv upgrade_available 0 ; setenv bootcount 0 ; setenv cfg_pending ; if saveenv && run ab_verify_rollback ; then run ab_setpart ; run boot_emmc ; echo "NO BOOTABLE SLOT" ; else echo "*** rollback env verify failed - halting ***" ; fi ; else echo "*** slot $active_slot failed - switching ***" ; if test "$active_slot" = b ; then setenv ab_expected_slot a ; setenv active_slot a ; else setenv ab_expected_slot b ; setenv active_slot b ; fi ; setexpr ab_expected_altcount $altcount + 1 ; setexpr altcount $altcount + 1 ; setenv bootcount 0 ; setenv upgrade_available 0 ; setenv cfg_pending ; if saveenv && run ab_verify_rollback ; then run ab_setpart ; run boot_emmc ; reset ; else echo "*** rollback env verify failed - halting ***" ; fi ; fi
emmc_write_hdr=mmc erase 0x0 0x40 && mmc write $fileaddr 0x0 0x40
golden_restore=@LED_WRITING@echo "*** GOLDEN RESTORE from NAND ***" ; mmc dev 0 && mmc bootbus 0 0 0 0 && ubi part ubi && run gr_bl && run gr_en8811h && run gr_env && run gr_slots && run emmc_erase_cfgstage && echo "*** restored - rebooting ***" ; reset
gr_bl=ubi read $loadaddr emmc_install && setenv fileaddr $loadaddr && run emmc_write_bl2 && setexpr fileaddr $loadaddr + 0x100000 && run emmc_write_fip && setexpr fileaddr $loadaddr + 0x500000 && run emmc_write_hdr
gr_en8811h=@GR_EN8811H@
emmc_write_en8811h_fw=@EMMC_WRITE_EN8811H_FW@
gr_env=setexpr envaddr $loadaddr + 0x600000 && mmc write $envaddr 0x2000 0x200 && mmc write $envaddr 0x2200 0x200
gr_slots=ubi read $loadaddr fit && iminfo $loadaddr && setenv part_default production && run emmc_write_production && setenv part_default production_b && run emmc_write_production
emmc_erase_cfgstage=if part start mmc 0 cfgstage part_addr && part size mmc 0 cfgstage part_size && mmc erase 0x$part_addr 0x$part_size ; then else echo "*** cfgstage not erased ***" ; fi
