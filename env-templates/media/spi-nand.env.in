ipaddr=10.1.1.3
serverip=10.1.1.1
loadaddr=@LOADADDR@
bootconf=config-1
bootdelay=1
usb_pgood_delay=4000
bootfile=@IMGPREFIX@-squashfs-sysupgrade.itb
bootfile_factory=snand-factory.bin
bootfile_factory_crc=snand-factory.crc
bootled_pwr=@BOOTLED_PWR@
bootled_rec=@BOOTLED_REC@
active_slot=a
altcount=0
bootlimit=3
ab_seed=if test "$envset" != 1 ; then run ubi_create_env ; setenv envset 1 ; saveenv ; fi
ab_setpart=if test "$active_slot" = b ; then setenv fitvol fit-b ; else setenv fitvol fit-a ; fi
ab_verify_rollback=env load && test "$active_slot" = "$ab_expected_slot" && test "$altcount" = "$ab_expected_altcount" && test -z "$cfg_pending" && test "$upgrade_available" = 0 && test "$bootcount" = 0
ubi_create_env=ubi check ubootenv || ubi create ubootenv @UBOOTENV_VOL@ dynamic ; ubi check ubootenv2 || ubi create ubootenv2 @UBOOTENV_VOL@ dynamic
ubi_prepare_rootfs=if ubi check rootfs_data ; then else ubi create rootfs_data @OVERLAY_SIZE@ dynamic ; fi ; if ubi check rootfs_data_alt ; then else ubi create rootfs_data_alt @OVERLAY_SIZE@ dynamic ; fi ; if ubi check cfgstage ; then else ubi create cfgstage 0x800000 dynamic ; fi ; run ab_cfgswap
ab_cfgswap=if test "$last_slot" = "$active_slot" ; then else if test "$last_slot" = "" ; then setenv last_slot $active_slot ; saveenv ; else ubi rename rootfs_data rootfs_data_tmp ; ubi rename rootfs_data_alt rootfs_data ; ubi rename rootfs_data_tmp rootfs_data_alt ; setenv last_slot $active_slot ; saveenv ; fi ; fi
ubi_read_production=ubi read $loadaddr $fitvol && iminfo $loadaddr && run ubi_prepare_rootfs
boot_production=led $bootled_pwr on ; run ubi_read_production && bootm $loadaddr#$bootconf ; led $bootled_pwr off
boot_ubi=run boot_production
boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
reset_factory=mw $loadaddr 0xff @UBOOTENV_VOL@ ; ubi write $loadaddr ubootenv @UBOOTENV_VOL@ ; ubi write $loadaddr ubootenv2 @UBOOTENV_VOL@ ; ubi remove rootfs_data
bootcmd=if button back ; then run usb_recover ; fi ; run ab_seed ; run ab_setpart ; run boot_ubi ; echo "*** boot failed - rebooting ***" ; reset
altbootcmd=if button back ; then run usb_recover ; fi ; if test "$altcount" -ge 4 ; then echo "*** A/B exhausted - halting ***" ; setenv ab_expected_slot $active_slot ; setenv ab_expected_altcount $altcount ; setenv upgrade_available 0 ; setenv bootcount 0 ; setenv cfg_pending ; if saveenv && run ab_verify_rollback ; then run ab_setpart ; run boot_ubi ; echo "NO BOOTABLE SLOT" ; else echo "*** rollback env verify failed - halting ***" ; fi ; else echo "*** slot $active_slot failed - switching ***" ; if test "$active_slot" = b ; then setenv ab_expected_slot a ; setenv active_slot a ; else setenv ab_expected_slot b ; setenv active_slot b ; fi ; setexpr ab_expected_altcount $altcount + 1 ; setexpr altcount $altcount + 1 ; setenv bootcount 0 ; setenv upgrade_available 0 ; setenv cfg_pending ; if saveenv && run ab_verify_rollback ; then run ab_setpart ; run boot_ubi ; reset ; else echo "*** rollback env verify failed - halting ***" ; fi ; fi
ab_reset=setenv active_slot a ; setenv bootcount 0 ; setenv altcount 0 ; setenv upgrade_available 0 ; saveenv
usb_recover=led $bootled_pwr on ; usb start && run usb_read_factory && run nand_write_factory && run usb_recover_done ; led white off ; led green off ; led orange off
usb_read_factory=if fatload usb 0 $loadaddr $bootfile_factory ; then setenv imgsz $filesize ; else usb reset ; if fatload usb 0 $loadaddr $bootfile_factory ; then setenv imgsz $filesize ; else setenv imgsz 0 ; fi ; fi ; test "$imgsz" != 0 && fatload usb 0 0x4f000000 $bootfile_factory_crc
verify_src=crc32 $loadaddr $imgsz 0x4f000004 && cmp.b 0x4f000000 0x4f000004 0x4
verify_nand=mtd read spi-nand0 0x4e000000 0x0 $imgsz && cmp.b $loadaddr 0x4e000000 $imgsz
nand_write_factory=led white on ; led green on ; led orange on ; run verify_src && mtd erase spi-nand0 && mtd write spi-nand0 $loadaddr 0x0 $imgsz && run verify_nand && run ab_reset
usb_recover_done=led green on ; echo "*** USB restore done - rebooting ***" ; reset
