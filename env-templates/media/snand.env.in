ipaddr=10.1.1.3
serverip=10.1.1.1
loadaddr=@LOADADDR@
bootargs=@BOOTARGS_BASE@ ubi.block=0,fit
bootconf=config-@DTBBASE@
bootconf_extra=@DTBBASE@-emmc
bootdelay=1
bootfile_bl2=@IMGPREFIX@-snand-preloader.bin
bootfile_fip=@IMGPREFIX@-snand-bl31-uboot.fip
bootfile=@IMGPREFIX@-squashfs-sysupgrade.itb
bootled_pwr=@BOOTLED_PWR@
bootled_rec=@BOOTLED_REC@
boot_production=led $bootled_pwr on ; run ubi_read_production && @BOOTM_PREPARE@bootm $loadaddr#$bootconf#$bootconf_extra ; led $bootled_pwr off
boot_ubi=run boot_production
boot_tftp_production=tftpboot $loadaddr $bootfile && env exists replacevol && iminfo $loadaddr && run ubi_write_production ; if env exists noboot ; then else @BOOTM_PREPARE@bootm $loadaddr#$bootconf#$bootconf_extra ; fi
boot_tftp=tftpboot $loadaddr $bootfile && @BOOTM_PREPARE@bootm $loadaddr#$bootconf
boot_tftp_write_fip=tftpboot $loadaddr $bootfile_fip && run ubi_write_fip && run reset_factory
boot_tftp_write_bl2=tftpboot $loadaddr $bootfile_bl2 && run snand_write_bl2
part_default=production
reset_factory=@RESET_FACTORY_SNAND@
snand_write_bl2=@SNAND_WRITE_BL2@
ubi_create_env=ubi check ubootenv || ubi create ubootenv @UBOOTENV_VOL@ dynamic ; ubi check ubootenv2 || ubi create ubootenv2 @UBOOTENV_VOL@ dynamic
ubi_prepare_rootfs=if ubi check rootfs_data ; then else if env exists rootfs_data_max ; then ubi create rootfs_data $rootfs_data_max dynamic || ubi create rootfs_data - dynamic ; else ubi create rootfs_data - dynamic ; fi ; fi
ubi_read_production=ubi read $loadaddr fit && iminfo $loadaddr && run ubi_prepare_rootfs
ubi_read_emmc_install=ubi check emmc_install && ubi read $loadaddr emmc_install
ubi_remove_rootfs=ubi check rootfs_data && ubi remove rootfs_data
ubi_write_fip=run ubi_remove_rootfs ; ubi check fip && ubi remove fip ; ubi create fip 0x200000 static ; ubi write $loadaddr fip 0x200000
ubi_write_production=ubi check fit && ubi remove fit ; run ubi_remove_rootfs ; ubi create fit $filesize dynamic && ubi write $loadaddr fit $filesize
mmc_write_vol=imszb $loadaddr image_size && test 0x$image_size -le 0x$part_size && mmc erase 0x$part_addr 0x$part_size && mmc write $loadaddr 0x$part_addr 0x$image_size
emmc_init=mmc dev 0 && mmc bootbus 0 0 0 0 && run emmc_init_bl && run emmc_write_env && run emmc_init_openwrt && run emmc_erase_cfgstage
emmc_init_bl=run ubi_read_emmc_install && setenv fileaddr $loadaddr && run emmc_write_bl2 && setexpr fileaddr $loadaddr + 0x100000 && run emmc_write_fip && setexpr fileaddr $loadaddr + 0x500000 && run emmc_write_hdr
emmc_init_openwrt=run ubi_read_production && iminfo $loadaddr && run emmc_write_production && run emmc_write_production_b
emmc_write_bl2=mmc partconf 0 1 1 1 && mmc erase 0x0 0x400 && mmc write $fileaddr 0x0 0x400 ; mmc partconf 0 1 1 0
emmc_write_fip=mmc erase 0x3400 0x2000 && mmc write $fileaddr 0x3400 0x2000 && mmc erase 0x2000 0x800
emmc_write_hdr=mmc erase 0x0 0x40 && mmc write $fileaddr 0x0 0x40
emmc_write_production=part start mmc 0 $part_default part_addr && part size mmc 0 $part_default part_size && run mmc_write_vol
emmc_write_production_b=part start mmc 0 production_b part_addr && part size mmc 0 production_b part_size && run mmc_write_vol
emmc_write_env=setexpr envaddr $loadaddr + 0x600000 && mmc write $envaddr 0x2000 0x200 && mmc write $envaddr 0x2200 0x200
emmc_erase_cfgstage=if part start mmc 0 cfgstage part_addr && part size mmc 0 cfgstage part_size && mmc erase 0x$part_addr 0x$part_size ; then else echo "*** cfgstage not erased ***" ; fi
_init_env=setenv _init_env ; run ubi_create_env ; saveenv ; saveenv
bootcmd=@LED_WRITING@run emmc_init@PROV_DONE@