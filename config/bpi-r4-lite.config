# ── 1. Target Hardware Platform (BPI-R4 Lite, MT7987A) ──
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r4-lite=y

# ── 2. Core Web Service (Nginx as uhttpd replacement) ──
CONFIG_PACKAGE_nginx-ssl=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-mod-admin-full=y

# ── 3. Wi-Fi 7 Driver (MT7987A + MT7996) + 2.5G PHY ──
CONFIG_PACKAGE_kmod-mt7996e=y
CONFIG_PACKAGE_kmod-mt7996-firmware=y
CONFIG_PACKAGE_kmod-mt7996-233-firmware=y
CONFIG_PACKAGE_mt7987-2p5g-phy-firmware=y
# CONFIG_PACKAGE_wpad-mbedtls is not set
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# ── 4. Hardware Acceleration ──
CONFIG_PACKAGE_kmod-nft-offload=y

# ── 5. Enterprise VPN Suite ──
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_luci-app-openvpn=y

# ── 6. Multi-WAN Load Balancing and Failover ──
CONFIG_PACKAGE_mwan3=y
# CONFIG_PACKAGE_luci-app-mwan3 is not set

# ── 7. Cellular Network Expansion (for the 1x M.2 slot) ──
# BPI-R4 Lite has one M.2 slot and can take a 5G module (RELEASE-ROADMAP
# §1.5.1), but this config carried none of the cellular stack -- so the slot
# was unusable. Release-blocking gap, fixed here to match bpi-r4.
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_usb-modeswitch=y
# comgt-ncm ships /lib/netifd/proto/ncm.sh, required by the NCM-class modules
# (RM500U). Absent from the R4 firmware as built (verified on hardware).
CONFIG_PACKAGE_comgt-ncm=y

# ── 8. Storage and USB ──
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# ── 9. SQM Smart Queue Management ──
CONFIG_PACKAGE_sqm-scripts=y
# CONFIG_PACKAGE_luci-app-sqm is not set

# ── 10. System Debugging and Common Tools ──
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_uboot-envtools=y

CONFIG_PACKAGE_kmod-sfp=y

# BPI-R4-Lite-V11 has two populated fan headers (FAN0 5V + FAN1 12V with TACH,
# series resistors fitted) and the board DTS enables pwm-fan on &pwm 2. Without
# this package CONFIG_SENSORS_PWM_FAN=m ships no driver, so a fan fitted to those
# headers cannot be driven by the thermal framework nor reported (BACKLOG N22).
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y

CONFIG_PACKAGE_kmod-rtc-pcf8563=y
CONFIG_PACKAGE_kmod-eeprom-at24=y
CONFIG_PACKAGE_kmod-gpio-pca953x=y
CONFIG_PACKAGE_kmod-i2c-mux-pca954x=y

CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_ip-full=y

CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_util-linux-lsblk=y
CONFIG_PACKAGE_iwinfo=y

CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_sysfsutils=y

# ── BpiRouter application layer ──
CONFIG_PACKAGE_bpirouter-ui=y
CONFIG_PACKAGE_bpirouter-base=y
