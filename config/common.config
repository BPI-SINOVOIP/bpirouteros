# common.config — packages applied to EVERY board (merged ahead of the
# per-board <board>.config seed by prepare.sh, then resolved via `make defconfig`).
# Use this for things that must be identical across the whole product line.
#
# NOTE: this pulls in a broad debug/diagnostic toolset (size/attack-surface cost).
# For a slimmed release build, split this into a debug-only fragment later.

# ── Network diagnostics ──
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ifstat=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_bwm-ng=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_netcat=y
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_iputils-arping=y
CONFIG_PACKAGE_openssh-client=y
CONFIG_PACKAGE_openssh-sftp-client=y

# ── iproute2 full (ss / ip / tc / nstat — ss replaces limited busybox netstat) ──
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ss=y
CONFIG_PACKAGE_tc=y
CONFIG_PACKAGE_nstat=y

# ── System / process ──
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_psmisc=y
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_file=y
CONFIG_PACKAGE_jq=y
# Formal on-device acceptance verifies the running apid inode and protected
# evidence ownership with stat. Keep this explicit rather than relying on a
# host utility or an optional BusyBox applet.
CONFIG_PACKAGE_coreutils-stat=y

# ── Hardware / storage (eMMC / NAND / PCIe / USB debugging) ──
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lscpu=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_mmc-utils=y

# ── Editors / shell / terminal ──
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_vim=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_tmux=y

# ── USB tethering / backup uplink (FUNCTIONAL — not part of the debug toolset
#    above; keep these when common.config is eventually split) ──
#
# Declared explicitly on every board on purpose. They must not depend on a
# cellular control package being selected transitively, because:
#   - bpi-r4-lite and openwrt-one had NONE of them, and could not do Android
#     USB tethering at all -- while USB tethering is openwrt-one's ONLY backup
#     uplink (it has no modem slot);
#   - anyone changing the cellular package selection would have silently
#     removed Android tethering from the other five.
# Naming them here makes the capability independent of the cellular stack.
#
# cdc-ncm  : Android 11+ default tethering mode, and NCM-class USB dongles
# cdc-ether: base class both of the others depend on; some dongles use it alone
# rndis    : older Android tethering; was missing on ALL boards
#
# rndis is NOT optional, and not merely "one more driver" -- do not drop it to
# save space. It selects CONFIG_USB_NET_RNDIS_HOST, and cdc_ether.c compiles its
# RNDIS recognition against that symbol:
#
#     #if IS_ENABLED(CONFIG_USB_NET_RNDIS_HOST)
#         ... real is_rndis() / is_wireless_rndis() / ...
#     #else
#         #define is_wireless_rndis(desc)  0
#     #endif
#
# Without it, usbnet_generic_cdc_bind() sees rndis == 0, and since Android RNDIS
# carries no CDC Ethernet descriptor it falls into
# `!info->header || (!rndis && !info->ether)` and rejects the device with
# "bad CDC descriptors". Every Android handset fails, on every board. Loading
# rndis_host.ko by hand does not help -- cdc_ether is already compiled blind.
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y

# The v1.5 runtime contract supports QMI and NCM only. Keep MBIM absent from
# every formal ImageBuilder package set explicitly: relying on "not selected"
# lets a future dependency silently add an unimplemented protocol back.
# CONFIG_PACKAGE_umbim is not set
# CONFIG_PACKAGE_kmod-usb-net-cdc-mbim is not set
