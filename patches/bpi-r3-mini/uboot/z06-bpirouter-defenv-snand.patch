+imgsz=0
+bootcmd=if run usb_image ; then run flash_nand ; else run emmc_install ; fi
+usb_image=usb start ; if fatload usb 0 $loadaddr snand-factory.bin ; then setenv imgsz $filesize ; else usb reset ; if fatload usb 0 $loadaddr snand-factory.bin ; then setenv imgsz $filesize ; else setenv imgsz 0 ; fi ; fi ; test "$imgsz" != "0"
+verify_src=crc32 $loadaddr $imgsz 0x4f000000 && fatload usb 0 0x4f000004 snand-factory.crc && cmp.b 0x4f000000 0x4f000004 4
+verify_nand=mtd read spi-nand0 0x60000000 0x0 $imgsz && cmp.b $loadaddr 0x60000000 $imgsz
+flash_nand=led $bootled_pwr off ; if run verify_src && mtd erase spi-nand0 && mtd write spi-nand0 $loadaddr 0x0 $imgsz && run verify_nand ; then led $bootled_pwr on ; echo "** NAND OK: remove USB, strap NAND, power-cycle **" ; else led $bootled_pwr off ; echo "** NAND VERIFY/WRITE FAILED - nothing or partial; re-flash **" ; fi
+emmc_install=led $bootled_pwr off ; if mmc dev 0 && mmc bootbus 0 0 0 0 && ubi part ubi && ubi read $loadaddr fit && iminfo $loadaddr && run gr_bl && run gr_en8811h && mmc rescan && run gr_slots ; then led $bootled_pwr on ; echo "** eMMC OK: set strap to eMMC and power-cycle **" ; else led $bootled_pwr off ; echo "** eMMC INSTALL FAILED **" ; fi
+gr_bl=ubi read $loadaddr emmc_install && setenv fileaddr $loadaddr && run emmc_write_bl2 && setexpr fileaddr $loadaddr + 0x100000 && run emmc_write_fip && setexpr fileaddr $loadaddr + 0x500000 && run emmc_write_hdr
+gr_slots=ubi read $loadaddr fit && iminfo $loadaddr && setenv part_default production && run emmc_write_production && setenv part_default production_b && run emmc_write_production
+emmc_write_bl2=mmc partconf 0 1 1 1 && mmc erase 0x0 0x400 && mmc write $fileaddr 0x0 0x400 ; mmc partconf 0 1 1 0
+emmc_write_fip=mmc erase 0x3400 0x2000 && mmc write $fileaddr 0x3400 0x2000 && mmc erase 0x2000 0x800
+emmc_write_hdr=mmc erase 0x0 0x40 && mmc write $fileaddr 0x0 0x40
+gr_en8811h=ubi read $loadaddr en8811h-fw && setenv fileaddr $loadaddr && run emmc_write_en8811h_fw
+emmc_write_en8811h_fw=mmc partconf 0 1 2 2 && mmc erase 0x0 0x120 && mmc write $fileaddr 0x0 0x120 ; mmc partconf 0 1 1 0
+emmc_write_production=part start mmc 0 $part_default part_addr && part size mmc 0 $part_default part_size && run mmc_write_vol
+mmc_write_vol=imszb $loadaddr image_size && test 0x$image_size -le 0x$part_size && mmc erase 0x$part_addr 0x$part_size && mmc write $loadaddr 0x$part_addr 0x$image_size
