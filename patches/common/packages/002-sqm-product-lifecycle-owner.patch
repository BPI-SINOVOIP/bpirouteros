diff --git a/net/sqm-scripts/patches/100-bpirouter-lifecycle-owner.patch b/net/sqm-scripts/patches/100-bpirouter-lifecycle-owner.patch
new file mode 100644
--- /dev/null
+++ b/net/sqm-scripts/patches/100-bpirouter-lifecycle-owner.patch
@@ -0,0 +1,68 @@
+--- a/platform/openwrt/sqm-hotplug
++++ b/platform/openwrt/sqm-hotplug
+@@ -1,3 +1,7 @@
+ #!/bin/sh
+ 
++# apid owns automatic SQM changes. Its netifd observer and periodic pass
++# handle device events, including events preceding apid startup.
++[ ! -x /usr/bin/bpirouter-apid ] || exit 0
++
+ . /lib/functions.sh
+--- a/platform/openwrt/sqm-init
++++ b/platform/openwrt/sqm-init
+@@ -5,6 +5,9 @@ USE_PROCD=1
+ 
+ service_triggers()
+ {
++	# Profile saves wake apid; config.change must not bypass its write lease.
++	[ ! -x /usr/bin/bpirouter-apid ] || return 0
++
+ 	procd_add_reload_trigger "sqm"
+ }
+ 
+@@ -28,6 +31,10 @@ stop_service()
+ 
+ boot()
+ {
++	# apid selects a current WAN after configuration recovery, at START=99.
++	# Leave explicit start/stop/reload available to that serialized owner.
++	[ ! -x /usr/bin/bpirouter-apid ] || return 0
++
+ 	export SQM_VERBOSITY_MIN=5 # Silence errors
+ 	start "$@"
+ }
+--- a/src/stop-sqm
++++ b/src/stop-sqm
+@@ -54,6 +54,17 @@
+     sqm_log "Stopping SQM on ${IFACE}"
+     sqm_stop
+ fi
++if [ -x /usr/bin/bpirouter-apid ]; then
++    # Failed deletion must not discard the state used by the next stop.
++    # Kernel default queues have handle 0:; product queues/ingress do not.
++    [ -z "$CUR_IFB" ] || [ ! -e "/sys/class/net/$CUR_IFB" ] || exit 1
++    if [ -e "/sys/class/net/$IFACE" ]; then
++        remaining=$($TC_BINARY -j qdisc show dev "$IFACE") || exit 1
++        printf '%s\n' "$remaining" |
++            jq -e 'type == "array" and all(.[]; .handle == "0:")' >/dev/null || exit 1
++    fi
++fi
++
+ rm -f "${STATE_FILE}"
+ 
+ exit 0
+--- a/src/start-sqm
++++ b/src/start-sqm
+@@ -58,6 +58,12 @@
+ sqm_trace; sqm_trace "$(date): Starting." # Add some space and a date stamp to verbose log output and log files to separate runs
+ sqm_log "Starting SQM script: ${SCRIPT} on ${IFACE}, in: ${DOWNLINK} Kbps, out: ${UPLINK} Kbps"
+ 
++if [ -x /usr/bin/bpirouter-apid ]; then
++    # A failed start may leave queues behind. The existing stop path needs
++    # their interface/script identity even when startup never completes.
++    write_state_file "${STATE_FILE}" || exit 1
++fi
++
+ if fn_exists sqm_start ; then
+     sqm_debug "Using script specific sqm_start function overriding the generic sqm_start_default."
+     sqm_start && write_state_file ${STATE_FILE} && sqm_log "${SCRIPT} was started on ${IFACE} successfully"
