+#!/bin/sh /etc/rc.common
+
+# Copyright 2020 Google LLC.
+# Copyright (C) 2021 CZ.NIC z.s.p.o. (https://www.nic.cz/)
+# Copyright (C) 2026 Ning <mimallaus@gmail.com>
+# SPDX-License-Identifier: Apache-2.0
+
+USE_PROCD=1
+START=80
+
+start_service() {
+  local status=0
+  /usr/bin/bpirouter-apid --s2s-service=check >/dev/null 2>&1 || status=$?
+  [ "$status" -ne 3 ] || return 0
+  [ "$status" -eq 0 ] || return 1
+
+  procd_open_instance
+  # The process prepares policy before exec and repeats the same check on
+  # respawn. A direct tailscaled command would reuse unchecked old preferences.
+  procd_set_param command /usr/bin/bpirouter-apid --s2s-service=run
+  procd_set_param env TS_NO_LOGS_NO_SUPPORT=true
+  procd_set_param respawn
+  # AuthURL is secret; never inherit configurable raw-log forwarding.
+  procd_set_param stdout 0
+  procd_set_param stderr 0
+  procd_close_instance
+}
+
+service_stopped() {
+  TS_NO_LOGS_NO_SUPPORT=true /usr/sbin/tailscaled --cleanup >/dev/null 2>&1
+}
