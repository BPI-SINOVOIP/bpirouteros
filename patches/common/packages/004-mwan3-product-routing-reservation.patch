diff --git a/net/mwan3/files/usr/sbin/mwan3rtmon b/net/mwan3/files/usr/sbin/mwan3rtmon
--- a/net/mwan3/files/usr/sbin/mwan3rtmon
+++ b/net/mwan3/files/usr/sbin/mwan3rtmon
@@ -19,6 +19,27 @@
 	kill -${1} ${2} 2>/dev/null
 }
 
+mwan3_rtmon_update()
+(
+	# Share the init/hotplug lock only for this synchronous update. A queued
+	# old monitor must reload configuration after stop has cleared its tables.
+	exec 9>/var/lock/procd_mwan3.lock
+	flock -x 9 || return 1
+	[ -d "$MWAN3_STATUS_DIR" ] || return 1
+	case "$1" in
+		ipv4) $IPT4 -S mwan3_hook >/dev/null 2>&1 || return 1 ;;
+		ipv6) $IPT6 -S mwan3_hook >/dev/null 2>&1 || return 1 ;;
+		*) return 1 ;;
+	esac
+	mwan3_init
+	if [ "$#" -eq 1 ]; then
+		mwan3_set_connected_${1}
+		mwan3_add_all_routes "$1"
+	else
+		mwan3_rtmon_route_handle "$2" "$1"
+	fi
+)
+
 mwan3_add_all_routes()
 {
 	local tid IP IPT route_line family active_tbls tid initial_state error
@@ -27,6 +48,9 @@
 	add_active_tbls()
 	{
 		let tid++
+		local enabled
+		config_get_bool enabled "$1" enabled 0
+		[ "$enabled" -eq 1 ] || return
 		config_get family "$1" family ipv4
 		config_get initial_state "$1" initial_state "online"
 		[ "$family" != "$ipv" ] && return
@@ -129,6 +153,9 @@
 	handle_route_cb(){
 		local iface=$1
 		let tid++
+		local enabled
+		config_get_bool enabled "$iface" enabled 0
+		[ "$enabled" -eq 1 ] || return
 		config_get family "$iface" family ipv4
 		[ "$family" != "$route_family" ] && return
 		handle_route "$iface"
@@ -150,8 +177,6 @@
 main()
 {
 	local IP family
-
-	mwan3_init
 
 	family=$1
 	[ -z $family ] && family=ipv4
@@ -171,13 +196,12 @@
 		while IFS='' read -r line; do
 			[ -z "${line##*table*}" ] && continue
 			LOG debug "handling route update $family '$line'"
-			mwan3_rtmon_route_handle "$line" "$family"
+			mwan3_rtmon_update "$family" "$line"
 		done
 	} &
 	child=$!
 	trap_with_arg func_trap "$child" SIGINT SIGTERM SIGKILL
-	mwan3_set_connected_${family}
-	mwan3_add_all_routes ${family}
+	mwan3_rtmon_update "$family"
 	kill -SIGCONT $child
 	wait $child
 }
