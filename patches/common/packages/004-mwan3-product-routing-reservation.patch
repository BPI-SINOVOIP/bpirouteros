diff --git a/net/mwan3/files/etc/init.d/mwan3 b/net/mwan3/files/etc/init.d/mwan3
--- a/net/mwan3/files/etc/init.d/mwan3
+++ b/net/mwan3/files/etc/init.d/mwan3
@@ -72,12 +72,18 @@
 			IP="$IP6"
 		fi
 
-		for tid in $($IP route list table all | sed -ne 's/.*table \([0-9]\+\).*/\1/p' | sort -u); do
-			[ $tid -gt $MWAN3_INTERFACE_MAX ] && continue
-			$IP route flush table $tid &> /dev/null
+		# The current config may already be empty or have fewer members.
+		# Sweep the product reservation, not other applications' low tables.
+		tid=1
+		while [ "$tid" -le "$MWAN3_PRODUCT_MAX" ]; do
+			$IP route flush table "$tid" &> /dev/null
+			tid=$((tid+1))
 		done
 
-		for rule in $($IP rule list | grep -E '^[1-3][0-9]{3}:' | cut -d ':' -f 1); do
+		for rule in $($IP rule list | awk -F : -v max="$MWAN3_PRODUCT_MAX" \
+			-v blackhole="$((MM_BLACKHOLE+2000))" -v unreachable="$((MM_UNREACHABLE+2000))" \
+			'($1 > 1000 && $1 < 4000 && $1 % 1000 >= 1 && $1 % 1000 <= max) ||
+			 $1 == blackhole || $1 == unreachable {print $1}'); do
 			$IP rule del pref $rule &> /dev/null
 		done
 		table="$($IPT -S)"
diff --git a/net/mwan3/files/lib/mwan3/common.sh b/net/mwan3/files/lib/mwan3/common.sh
--- a/net/mwan3/files/lib/mwan3/common.sh
+++ b/net/mwan3/files/lib/mwan3/common.sh
@@ -9,6 +9,7 @@
 MWAN3TRACK_STATUS_DIR="/var/run/mwan3track"
 
 MWAN3_INTERFACE_MAX=""
+MWAN3_PRODUCT_MAX=8
 
 MMX_MASK=""
 MMX_DEFAULT=""
@@ -155,11 +156,21 @@
 	esac
 }
 
+mwan3_count_product_iface()
+{
+	product_iface_count=$((product_iface_count+1))
+}
+
 mwan3_init()
 {
-	local bitcnt mmdefault source_routing
+	local bitcnt mmdefault source_routing product_iface_count=0
 
 	config_load mwan3
+	config_foreach mwan3_count_product_iface interface
+	if [ "$product_iface_count" -gt "$MWAN3_PRODUCT_MAX" ]; then
+		LOG err "Interface count exceeds the product routing-table reservation; configuration preserved"
+		exit 1
+	fi
 
 	[ -d $MWAN3_STATUS_DIR ] || mkdir -p $MWAN3_STATUS_DIR/iface_state
 	[ -d "$MWAN3_STATUS_IPTABLES_LOG_DIR" ] || mkdir -p "$MWAN3_STATUS_IPTABLES_LOG_DIR"
