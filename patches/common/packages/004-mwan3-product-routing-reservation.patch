 	mwan3_get_iface_id id "$1"
 
 	[ -n "$id" ] || return 0
+	[ "$id" -ge 1 ] && [ "$id" -le "$MWAN3_PRODUCT_MAX" ] || return 1
 
 	if [ "$family" = "ipv4" ]; then
 		IP="$IP4"
@@ -500,6 +502,7 @@
 		LOG warn "delete_iface_route: could not find table id for interface $1"
 		return 0
 	fi
+	[ "$id" -ge 1 ] && [ "$id" -le "$MWAN3_PRODUCT_MAX" ] || return 1
 
 	if [ "$family" = "ipv4" ]; then
 		$IP4 route flush table "$id"
@@ -516,6 +519,7 @@
 	mwan3_get_iface_id id "$1"
 
 	[ -n "$id" ] || return 0
+	[ "$id" -ge 1 ] && [ "$id" -le "$MWAN3_PRODUCT_MAX" ] || return 1
 
 	if [ "$family" = "ipv4" ]; then
 		IP="$IP4"
@@ -540,6 +544,7 @@
 	mwan3_get_iface_id id "$1"
 
 	[ -n "$id" ] || return 0
+	[ "$id" -ge 1 ] && [ "$id" -le "$MWAN3_PRODUCT_MAX" ] || return 1
 
 	if [ "$family" = "ipv4" ]; then
 		IP="$IP4"
@@ -549,7 +554,7 @@
 		return
 	fi
 
-	for rule_id in $(ip rule list | awk -F : '$1 % 1000 == '$id' && $1 > 1000 && $1 < 4000 {print $1}'); do
+	for rule_id in $($IP rule list | awk -F : -v id="$id" '$1 == 1000+id || $1 == 2000+id || $1 == 3000+id {print $1}'); do
 		$IP rule del pref $rule_id
 	done
