+ncm_get_manufacturer() {
+	gcom -d "$1" -s /etc/gcom/getcardinfo.gcom |
+		tr -d '\r' |
+		awk '
+			/^[[:space:]]*$/ || /^AT\+CGMI/ || /^(OK|ERROR)$/ { next }
+			/^\+CGMI:[[:space:]]*/ {
+				sub(/^\+CGMI:[[:space:]]*/, "")
+				if (NF) { print tolower($1); exit }
+				next
+			}
+			/^\+/ || /^(RDY|APP RDY|PB DONE)$/ { next }
+			{ print tolower($1); exit }
+		'
+}
