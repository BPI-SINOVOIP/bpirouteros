diff --git a/package/network/utils/uqmi/patches/100-fix-ctl-data-format-request.patch b/package/network/utils/uqmi/patches/100-fix-ctl-data-format-request.patch
new file mode 100644
--- /dev/null
+++ b/package/network/utils/uqmi/patches/100-fix-ctl-data-format-request.patch
@@ -0,0 +1,47 @@
+From: BpiRouter Project <noreply@bpirouter.local>
+Subject: [PATCH] uqmi: send and report the requested CTL data format
+
+The command parsed its argument but built an empty request and returned DONE,
+so no CTL transaction was sent.  Return the protocol acknowledged by the
+modem as a JSON string so netifd can require positive format evidence.
+---
+ uqmi/commands.c | 32 ++++++++++++++++++++++++++++----
+ 1 file changed, 28 insertions(+), 4 deletions(-)
+
+--- a/uqmi/commands.c
++++ b/uqmi/commands.c
+@@ -148 +148,21 @@
+-#define cmd_ctl_set_data_format_cb no_cb
++static void
++cmd_ctl_set_data_format_cb(struct qmi_dev *qmi, struct qmi_request *req, struct qmi_msg *msg)
++{
++	struct qmi_ctl_set_data_format_response res;
++	const char *protocol = "unknown";
++
++	qmi_parse_ctl_set_data_format_response(msg, &res);
++	if (res.set.protocol) {
++		switch (res.data.protocol) {
++		case QMI_CTL_DATA_LINK_PROTOCOL_802_3:
++			protocol = "802.3";
++			break;
++		case QMI_CTL_DATA_LINK_PROTOCOL_RAW_IP:
++			protocol = "raw-ip";
++			break;
++		}
++	}
++
++	blobmsg_add_string(&status, NULL, protocol);
++}
++
+@@ -152 +172,0 @@
+-	struct qmi_ctl_set_data_format_request sreq = {};
+@@ -164,2 +183,7 @@
++	struct qmi_ctl_set_data_format_request sreq = {
++		QMI_INIT(format, QMI_CTL_DATA_FORMAT_QOS_FLOW_HEADER_ABSENT),
++		QMI_INIT(protocol, mode),
++	};
++
+-	qmi_set_ctl_set_data_format_request(msg, &sreq);
+-	return QMI_CMD_DONE;
++	qmi_set_ctl_set_data_format_request(msg, &sreq);
++	return QMI_CMD_REQUEST;
