++void
++interface_ip_remove_target_route(union if_addr *addr, bool v6, struct interface *iface)
++{
++	struct device_route *route, *tmp;
++	struct interface_ip_settings *ip[] = { &iface->config_ip, &iface->proto_ip };
++	bool removed = false;
++
++	/* Only dependency-created host routes belong to protocol teardown.
++	 * Explicit ubus routes and configured routes retain their own lifetime. */
++	vlist_for_each_element_safe(&iface->host_routes, route, node, tmp) {
++		if (route->keep_host_route || route->mask != (v6 ? 128 : 32) ||
++		    v6 != ((route->flags & DEVADDR_FAMILY) == DEVADDR_INET6) ||
++		    memcmp(&route->addr, addr, v6 ? sizeof(addr->in6) : sizeof(addr->in)))
++			continue;
++		vlist_delete(&iface->host_routes, &route->node);
++		removed = true;
++	}
++	if (!removed)
++		return;
++
++	/* A host route may have been configured after the dependency was added.
++	 * Both lists then describe one kernel entry. Restore the current owners
++	 * after deleting the dependency, without retaining an orphan clone. */
++	for (unsigned int i = 0; i < ARRAY_SIZE(ip); i++) {
++		vlist_for_each_element(&ip[i]->route, route, node) {
++			if (!route->enabled || route->mask != (v6 ? 128 : 32) ||
++			    v6 != ((route->flags & DEVADDR_FAMILY) == DEVADDR_INET6) ||
++			    memcmp(&route->addr, addr, v6 ? sizeof(addr->in6) : sizeof(addr->in)))
++				continue;
++			route->failed = !!system_add_route(iface->l3_dev.dev, route);
++		}
++	}
++}
++
+ static void
+ interface_set_route_info(struct interface *iface, struct device_route *route)
+ {
+@@ -886,8 +923,14 @@ interface_update_host_route(struct vlist_tree *tree,
+ 			     struct vlist_node *node_old)
+ {
+ 	struct interface *iface;
++	struct device_route *old, *new;
+ 
+ 	iface = container_of(tree, struct interface, host_routes);
++	if (node_new && node_old) {
++		old = container_of(node_old, struct device_route, node);
++		new = container_of(node_new, struct device_route, node);
++		new->keep_host_route |= old->keep_host_route;
++	}
+ 	__interface_update_route(&iface->proto_ip, node_new, node_old);
+ }
