+--- a/proto-shell.c
++++ b/proto-shell.c
+@@ -139,7 +139,7 @@ proto_shell_update_host_dep(struct proto_shell_dependency *dep)
+ 	}
+ 
+ 	if (!dep->any)
+-		iface = interface_ip_add_target_route(&dep->host, dep->v6, iface, false);
++		iface = interface_ip_add_target_route(&dep->host, dep->v6, iface, false, false);
+ 
+ 	if (!iface)
+ 		goto out;
+@@ -152,13 +152,38 @@ out:
+ 	proto_shell_check_dependencies(dep->proto);
