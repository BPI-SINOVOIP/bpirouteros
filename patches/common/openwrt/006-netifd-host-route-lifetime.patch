+diff --git a/interface.c b/interface.c
+index b0442bd..764f47d 100644
+--- a/interface.c
++++ b/interface.c
+@@ -1174,6 +1174,9 @@ interface_set_down(struct interface *iface)
+ 	} else {
+ 		iface->autostart = false;
+ 		netifd_ucode_check_network_enabled();
