+ 
+ struct interface *
+ interface_ip_add_target_route(union if_addr *addr, bool v6, struct interface *iface,
+-			      bool exclude)
++			      bool exclude, bool keep)
+ {
+ 	struct device_route *route, *r_next = NULL;
+ 	bool defaultroute_target = false;
+@@ -302,7 +302,9 @@ interface_ip_add_target_route(union if_addr *addr, bool v6, struct interface *if
+ 		return NULL;
+ 
+ 	iface = r_next->iface;
+-	if (defaultroute_target)
++	/* An existing host route already reaches the endpoint and belongs to
++	 * its configured/protocol route list, not to a dependency clone. */
++	if (defaultroute_target || r_next->mask == (v6 ? 128 : 32))
+ 		return iface;
+ 
+ 	route = calloc(1, sizeof(*route));
+@@ -317,11 +319,46 @@ interface_ip_add_target_route(union if_addr *addr, bool v6, struct interface *if
+ 	route->metric = r_next->metric;
+ 	route->table = r_next->table;
+ 	route->iface = iface;
++	route->keep_host_route = keep;
+ 	vlist_add(&iface->host_routes, &route->node, route);
+ 
+ 	return iface;
+ }
