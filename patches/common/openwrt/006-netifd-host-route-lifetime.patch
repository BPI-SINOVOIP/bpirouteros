++static void
++proto_shell_release_host_dep(struct proto_shell_dependency *dep)
++{
++	struct interface *iface = dep->dep.iface;
++	struct interface_user *user;
++	struct proto_shell_dependency *other;
++
++	interface_remove_user(&dep->dep);
++	if (!iface || dep->any)
++		return;
++
++	/* The existing interface users are the ownership list. A second tunnel
++	 * may still need this endpoint on the same uplink. */
++	list_for_each_entry(user, &iface->users, list) {
++		if (user->cb != proto_shell_if_down_cb)
++			continue;
++		other = container_of(user, struct proto_shell_dependency, dep);
++		if (!other->any && other->v6 == dep->v6 &&
++		    !memcmp(&other->host, &dep->host,
++			    dep->v6 ? sizeof(dep->host.in6) : sizeof(dep->host.in)))
++			return;
++	}
++	interface_ip_remove_target_route(&dep->host, dep->v6, iface);
++}
++
+ static void
+ proto_shell_clear_host_dep(struct proto_shell_state *state)
+ {
+ 	struct proto_shell_dependency *dep, *tmp;
+ 
+ 	list_for_each_entry_safe(dep, tmp, &state->deps, list) {
+-		interface_remove_user(&dep->dep);
++		proto_shell_release_host_dep(dep);
+ 		list_del(&dep->list);
+ 		free(dep);
+ 	}
+@@ -182,6 +207,14 @@ proto_shell_handler(struct interface_proto_state *proto,
+ 	handler = state->handler;
+ 	proc = &state->script_task;
+ 
++	/* An explicit stop while waiting for an uplink has no running lifetime
++	 * to tear down. Drop its dependencies without launching another script. */
++	if (cmd == PROTO_CMD_TEARDOWN && !proto_shell_busy(proto) &&
++	    proto->iface->state == IFS_DOWN && !proto->iface->autostart) {
++		proto_shell_clear_host_dep(state);
++		return 0;
++	}
++
+ 	if (cmd == PROTO_CMD_SETUP) {
+ 		/* Explicit ifup enables autostart even for auto=0. Close it in
+ 		 * netifd before allocation/fork/slot admission can reject the script. */
+@@ -303,7 +336,7 @@ proto_shell_if_down_cb(struct interface_user *dep, struct interface *iface,
+ 		return;
+ 
+ 	pdep = container_of(dep, struct proto_shell_dependency, dep);
+-	interface_remove_user(dep);
++	proto_shell_release_host_dep(pdep);
+ 	dep->cb = proto_shell_if_up_cb;
+ 	interface_add_user(dep, NULL);
+ 
+@@ -371,6 +404,10 @@ proto_shell_task_finish(struct proto_shell_state *state,
+ 		/* completed tearing down all tasks, now idle */
+ 		uloop_timeout_cancel(&state->teardown_timeout);
+ 		uloop_timeout_cancel(&state->checkup_timeout);
++		/* Explicit ifdown must release endpoint routes. Automatic link-loss
++		 * teardown keeps dependencies so uplink recovery can wake the proto. */
++		if (!state->proto.iface->autostart)
++			proto_shell_clear_host_dep(state);
+ 		state->sm = S_IDLE;
+ 		state->proto.proto_event(&state->proto, IFPEV_DOWN);
+ 		break;
