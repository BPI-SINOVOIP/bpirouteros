 	chosen {
 		stdout-path = "serial0:115200n8";
-		rootdisk = <&ubi_fit_volume>;
+		rootdisk = <&ubi_fit_a>;
+		rootdisk-spim-nand = <&ubi_fit_a>;
+		rootdisk-spim-nand-a = <&ubi_fit_a>;
+		rootdisk-spim-nand-b = <&ubi_fit_b>;
 	};
 
 	memory@40000000 {
@@ -331,8 +334,11 @@
 				compatible = "linux,ubi";
 
 				volumes {
-					ubi_fit_volume: ubi-volume-fit {
-						volname = "fit";
+					ubi_fit_a: ubi-volume-fit-a {
