--- /dev/null
+++ b/defenvs/openwrt-one-ram_env
@@ -0,0 +1,13 @@
+ipaddr=10.1.1.3
+serverip=10.1.1.1
+loadaddr=0x46000000
+usb_pgood_delay=4000
+bootdelay=3
+bootfile_factory=snand-factory.bin
+bootfile_factory_crc=snand-factory.crc
+usb_image=usb start ; if fatload usb 0 $loadaddr $bootfile_factory ; then setenv imgsz $filesize ; else usb reset ; if fatload usb 0 $loadaddr $bootfile_factory ; then setenv imgsz $filesize ; else setenv imgsz 0 ; fi ; fi ; test "$imgsz" != 0 && fatload usb 0 0x4f000000 $bootfile_factory_crc
+verify_src=crc32 $loadaddr $imgsz 0x4f000004 && cmp.b 0x4f000000 0x4f000004 0x4
+verify_nand=mtd read spi-nand0 0x4e000000 0x0 $imgsz && cmp.b $loadaddr 0x4e000000 $imgsz
+flash_nand=led white on ; led green on ; led orange on ; run verify_src && mtd erase spi-nand0 && mtd write spi-nand0 $loadaddr 0x0 $imgsz && run verify_nand
+provision=if run usb_image ; then if run flash_nand ; then led white off ; led orange off ; led green on ; echo "*** PROVISION OK - booting NAND ***" ; reset ; else led white off ; led green off ; led orange off ; echo "*** flash/verify FAILED - check USB image ***" ; fi ; fi
+bootcmd=led green off ; led white off ; echo "*** provisioning: insert USB with snand-factory.bin (Ctrl-C for prompt) ***" ; while true ; do run provision ; led orange on ; sleep 1 ; led orange off ; sleep 2 ; done
