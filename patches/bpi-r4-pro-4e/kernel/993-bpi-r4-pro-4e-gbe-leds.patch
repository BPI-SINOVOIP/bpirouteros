Light the 4E ETH5, ETH6 and ETH7 jack LEDs.

They are driven by SoC pins (GPIO64/66/68) that the DT left in GPIO mode.
Mux them to the switch-PHY and 2.5G-PHY LED functions.

--- a/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-4e.dts
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-4e.dts
@@ -209,6 +209,62 @@
 	label = "lan4";
 };
 
+/* CM05/CM17/CM18: on the 4E, ETH5 (P0), ETH6 (P2) and ETH7 (2.5G PHY) each have
+ * one jack LED driven by the SoC: GPIO64 LED_A, GPIO66 LED_C and GPIO68 LED_E.
+ * The pins default to GPIO, so the LEDs stayed dark. Mux them to "led"; the
+ * switch PHY driver takes the polarity from the boot straps these pins share,
+ * and the 2.5G PHY driver switches its pin only after setting the polarity.
+ * The jacks' second LED is not driven on the 4E. GPIO67 (LED_D, ETH8 on the
+ * CN37 header, also the SW3_A strap) is left alone.
+ */
+&gsw_phy0 {
+	pinctrl-names = "gbe-led";
+	pinctrl-0 = <&gbe0_led0_pins>;
+};
+
+&gsw_phy0_led0 {
+	status = "okay";
+	color = <LED_COLOR_ID_YELLOW>;
+};
+
+&gsw_phy2 {
+	pinctrl-names = "gbe-led";
+	pinctrl-0 = <&gbe2_led0_pins>;
+};
+
+&gsw_phy2_led0 {
+	status = "okay";
+	color = <LED_COLOR_ID_YELLOW>;
+};
+
+&int_2p5g_phy {
+	pinctrl-names = "i2p5gbe-led";
+	pinctrl-0 = <&i2p5gbe_led0_pins>;
+};
+
+&pio {
+	gbe0_led0_pins: gbe0-led0-pins {
+		mux {
+			function = "led";
+			groups = "gbe0_led0";
+		};
+	};
+
+	gbe2_led0_pins: gbe2-led0-pins {
+		mux {
+			function = "led";
+			groups = "gbe2_led0";
+		};
+	};
+
+	i2p5gbe_led0_pins: i2p5gbe-led0-pins {
+		mux {
+			function = "led";
+			groups = "2p5gbe_led0";
+		};
+	};
+};
+
 &pio {
 	mdio0_pins: mdio0-pins {
 		mux {
