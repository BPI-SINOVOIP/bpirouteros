--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-4e.dts
@@ -0,0 +1,482 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Banana Pi BPI-R4 Pro 4E (MT7988A).
+ * Wiring: BPI-R4Pro-V10-SCH-20250806, CM14/CM17/CM99 (4E).
+ * See NETWORK-TOPOLOGY.md for address and upstream port-number evidence.
+ * This is independent of the 8X DTS: no external 10G copper PHY.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+#include "mt7988a.dtsi"
+
+/ {
+	compatible = "bananapi,bpi-r4-pro-4e", "mediatek,mt7988a";
+	model = "Banana Pi BPI-R4 Pro 4E";
+	chassis-type = "embedded";
+
+	aliases {
+		ethernet0 = &gmac0;
+		ethernet1 = &gmac1;
+		ethernet2 = &gmac2;
+		serial0 = &serial0;
+		led-failsafe = &led_err;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		bootargs = "console=ttyS0,115200n1 pci=pcie_bus_perf ubi.block=0,fit root=/dev/fit0";
+		rootdisk-spim-nand = <&ubi_rootfs>;
+	};
+
+	fan: pwm-fan {
+		compatible = "pwm-fan";
+		/* CN36/CN38 are 4-pin KK254 fan headers (12V, GND, PWM, TACH) driven
+		 * from GPIO57_PWMD0 through R895 0R -- a direct, non-inverted drive,
+		 * so duty rises with cooling demand (BPI-R4Pro-V10 sheet CM19).
+		 * Same PWM channel and period the MT7988A r4 uses. */
+		cooling-levels = <0 80 128 255>;
+		#cooling-cells = <2>;
+		pwms = <&pwm 0 50000>;
+		status = "okay";
+	};
+
+	/* Bootstrap window; U-Boot supplies the RAM size detected by BL2. */
+	memory@40000000 {
+		reg = <0x00 0x40000000 0x00 0x10000000>;
+		device_type = "memory";
+	};
+
+	reg_3p3v: regulator-3p3v {
+		compatible = "regulator-fixed";
+		regulator-name = "fixed-3.3V";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	reg_1p8v: regulator-1p8v {
+		compatible = "regulator-fixed";
+		regulator-name = "fixed-1.8V";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&pio 13 GPIO_ACTIVE_LOW>;
+		};
+
+		wps {
+			label = "wps";
+			linux,code = <KEY_WPS_BUTTON>;
+			gpios = <&pio 14 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	gpio-leds {
+		compatible = "gpio-leds";
+
+		led_act: led-act {
+			label = "act";
+			gpios = <&pca9555 14 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "heartbeat";
+		};
+
+		led_err: led-err {
+			label = "err";
+			gpios = <&pca9555 15 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
+
+	/* CM17: LAN cage is connected to MxL SerDes 1. */
+	sfp_lan: sfp-lan {
+		compatible = "sff,sfp";
+		i2c-bus = <&sfp_lan_i2c>;
+		mod-def0-gpios = <&pio 69 GPIO_ACTIVE_LOW>;
+		los-gpios = <&pio 70 GPIO_ACTIVE_HIGH>;
+		tx-disable-gpios = <&pio 21 GPIO_ACTIVE_HIGH>;
+		maximum-power-milliwatt = <3000>;
+	};
+
+	/* Step 4 enables this only in the SFP WAN overlay. */
+	sfp_wan: sfp-wan {
+		compatible = "sff,sfp";
+		i2c-bus = <&sfp_wan_i2c>;
+		mod-def0-gpios = <&pio 1 GPIO_ACTIVE_LOW>;
+		los-gpios = <&pio 2 GPIO_ACTIVE_HIGH>;
+		tx-disable-gpios = <&pio 0 GPIO_ACTIVE_HIGH>;
+		maximum-power-milliwatt = <3000>;
+		status = "disabled";
+	};
+};
+
+&serial0 {
+	status = "okay";
+};
+
+&pwm {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm0_pins>;
+	status = "okay";
+};
+
+&cpu_thermal {
+	/* mt7988a.dtsi declares only the 125C critical trip; the active trips that
+	 * drive a fan live in the per-board dtsi, so mirror the MT7988A r4 ramp. */
+	trips {
+		cpu_trip_active_high: active-high {
+			temperature = <115000>;
+			hysteresis = <2000>;
+			type = "active";
+		};
+
+		cpu_trip_active_med: active-med {
+			temperature = <85000>;
+			hysteresis = <2000>;
+			type = "active";
+		};
+
+		cpu_trip_active_low: active-low {
+			temperature = <40000>;
+			hysteresis = <2000>;
+			type = "active";
+		};
+	};
+
+	cooling-maps {
+		map-cpu-active-high {
+			cooling-device = <&fan 3 3>;
+			trip = <&cpu_trip_active_high>;
+		};
+
+		map-cpu-active-med {
+			cooling-device = <&fan 2 2>;
+			trip = <&cpu_trip_active_med>;
+		};
+
+		map-cpu-active-low {
+			cooling-device = <&fan 1 1>;
+			trip = <&cpu_trip_active_low>;
+		};
+	};
+};
+
+&eth {
+	pinctrl-names = "default";
+	pinctrl-0 = <&mdio0_pins>;
+	status = "okay";
+};
+
+&gmac0 {
+	status = "okay";
+};
+
+&switch {
+	dsa,member = <0 0>;
+	status = "okay";
+};
+
+&gsw_port0 {
+	label = "lan1";
+};
+
+/* P1 is not routed on 4E. ETH5=P0, ETH6=P2, ETH8/FPC=P3. */
+&gsw_port1 {
+	status = "disabled";
+};
+
+&gsw_phy1 {
+	status = "disabled";
+};
+
+&gsw_port2 {
+	label = "lan3";
+};
+
+&gsw_port3 {
+	label = "lan4";
+};
+
+&pio {
+	mdio0_pins: mdio0-pins {
+		mux {
+			function = "eth";
+			groups = "mdc_mdio0";
+		};
+	};
+
+	pwm0_pins: pwm0-pins {
+		mux {
+			function = "pwm";
+			groups = "pwm0";
+		};
+	};
+
+	/* CM17: GPIO54=0 selects the LAN SFP path, not the unpopulated PHY. */
+	lan_sfp_hog: lan-sfp-hog {
+		gpio-hog;
+		gpios = <54 GPIO_ACTIVE_HIGH>;
+		output-low;
+	};
+
+	mmc0_pins_emmc_51: mmc0-emmc-51-pins {
+		mux {
+			function = "flash";
+			groups = "emmc_51";
+		};
+	};
+
+	mmc0_pins_sdcard: mmc0-sdcard-pins {
+		mux {
+			function = "flash";
+			groups = "sdcard";
+		};
+	};
+
+	spi0_flash_pins: spi0-flash-pins {
+		mux {
+			function = "spi";
+			groups = "spi0", "spi0_wp_hold";
+		};
+	};
+
+	i2c2_1_pins: i2c2-g1-pins {
+		mux {
+			function = "i2c";
+			groups = "i2c2_1";
+		};
+	};
+};
+
+&spi0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi0_flash_pins>;
+	status = "okay";
+
+	spi_nand: flash@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <52000000>;
+		spi-tx-bus-width = <4>;
+		spi-rx-bus-width = <4>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "bl2";
+				reg = <0x0 0x200000>;
+				read-only;
+			};
+
+			partition@200000 {
+				label = "ubi";
+				reg = <0x200000 0xfe00000>;
+				compatible = "linux,ubi";
+
+				volumes {
+					ubi-volume-ubootenv {
+						volname = "ubootenv";
+						nvmem-layout {
+							compatible = "u-boot,env-redundant-bool-layout";
+						};
+					};
+
+					ubi-volume-ubootenv2 {
+						volname = "ubootenv2";
+						nvmem-layout {
+							compatible = "u-boot,env-redundant-bool-layout";
+						};
+					};
+
+					ubi_rootfs: ubi-volume-fit {
+						volname = "fit";
+					};
+				};
+			};
+		};
+	};
+};
+
+/* CM07/CM12: SSUSB_P1 -> VL822 -> three M.2 Key-B slots and Type-A. */
+&ssusb1 {
+	status = "okay";
+};
+
+/* Shared PCB PCIe controllers; card population is checked on the 4E board. */
+&pcie0 {
+	status = "okay";
+};
+
+&pcie1 {
+	status = "okay";
+};
+
+&pcie2 {
+	status = "okay";
+};
+
+&pcie3 {
+	status = "okay";
+};
+
+&tphy {
+	/* PCIe t-phy for pcie0/1/3 — without it the controllers deferred-probe
+	 * and nothing enumerates (same as R4 patch 040). */
+	status = "okay";
+};
+
+&xsphy {
+	/* PCIe2 xs-phy (shared with ssusb0) — R4 patch 172. */
+	status = "okay";
+};
+
+&i2c2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c2_1_pins>;
+	status = "okay";
+
+	pca9545: i2c-mux@70 {
+		compatible = "nxp,pca9545";
+		reg = <0x70>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		i2c@0 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <0>;
+
+			pca9555: gpio@20 {
+				compatible = "nxp,pca9555";
+				reg = <0x20>;
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+		};
+
+		sfp_lan_i2c: i2c@1 {
+			reg = <1>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+		};
+
+		sfp_wan_i2c: i2c@2 {
+			reg = <2>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+		};
+	};
+};
+
+/* One WAN overlay supplies the attachment; the base cannot probe either path. */
+&gmac1 {
+	openwrt,netdev-name = "wan";
+	status = "disabled";
+};
+
+&int_2p5g_phy {
+	status = "disabled";
+};
+
+/* CM14: SoC USXGMII_0 -> MxL SerDes 0; upstream single-lane anchor is 9. */
+&gmac2 {
+	phy-mode = "10gbase-r";
+	phy-connection-type = "10gbase-r";
+	status = "okay";
+
+	fixed-link {
+		speed = <10000>;
+		full-duplex;
+		pause;
+	};
+};
+
+&mdio_bus {
+	/* Conservative bus clock shared with the existing MxL driver stack. */
+	clock-frequency = <12500000>;
+
+	mxl_switch: switch@10 {
+		compatible = "maxlinear,mxl86252";
+		reg = <0x10>;
+		dsa,member = <1 0>;
+		status = "okay";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@1 {
+				reg = <1>;
+				label = "mxl_lan0";
+				phy-handle = <&mxl_phy0>;
+				phy-mode = "internal";
+			};
+
+			port@2 {
+				reg = <2>;
+				label = "mxl_lan1";
+				phy-handle = <&mxl_phy1>;
+				phy-mode = "internal";
+			};
+
+			port@3 {
+				reg = <3>;
+				label = "mxl_lan2";
+				phy-handle = <&mxl_phy2>;
+				phy-mode = "internal";
+			};
+
+			port@4 {
+				reg = <4>;
+				label = "mxl_lan3";
+				phy-handle = <&mxl_phy3>;
+				phy-mode = "internal";
+			};
+
+			port@9 {
+				reg = <9>;
+				ethernet = <&gmac2>;
+				phy-mode = "10gbase-r";
+				dsa-tag-protocol = "mxl862xx-8021q";
+
+				fixed-link {
+					speed = <10000>;
+					full-duplex;
+				};
+			};
+
+			/* CM14/CM17: SerDes 1 -> LAN SFP, upstream anchor 13. */
+			port@d {
+				reg = <13>;
+				label = "sfp-lan";
+				phy-mode = "10gbase-r";
+				managed = "in-band-status";
+				sfp = <&sfp_lan>;
+			};
+		};
+
+		mdio {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			mxl_phy0: ethernet-phy@0 { reg = <0>; };
+			mxl_phy1: ethernet-phy@1 { reg = <1>; };
+			mxl_phy2: ethernet-phy@2 { reg = <2>; };
+			mxl_phy3: ethernet-phy@3 { reg = <3>; };
+		};
+	};
+};

--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-4e-emmc.dtso
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Copyright (C) 2021 MediaTek Inc.
+ * Author: Frank Wunderlich <frank-w@public-files.de>
+ */
+
+/dts-v1/;
+/plugin/;
+
+/ {
+	compatible = "bananapi,bpi-r4-pro-4e", "mediatek,mt7988a";
+};
+
+&{/soc/mmc@11230000} {
+	pinctrl-names = "default", "state_uhs";
+	pinctrl-0 = <&mmc0_pins_emmc_51>;
+	pinctrl-1 = <&mmc0_pins_emmc_51>;
+	bus-width = <8>;
+	max-frequency = <200000000>;
+	cap-mmc-highspeed;
+	mmc-hs200-1_8v;
+	mmc-hs400-1_8v;
+	hs400-ds-delay = <0x12814>;
+	vqmmc-supply = <&reg_1p8v>;
+	vmmc-supply = <&reg_3p3v>;
+	non-removable;
+	no-sd;
+	no-sdio;
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	card@0 {
+		compatible = "mmc-card";
+		reg = <0>;
+
+		partitions {
+			compatible = "gpt-partitions";
+
+			block-partition-env {
+				partname = "ubootenv";
+				nvmem-layout {
+					compatible = "u-boot,env-layout";
+				};
+			};
+
+			emmc_rootfs: block-partition-production {
+				partname = "production";
+			};
+
+			emmc_rootfs_b: block-partition-production_b {
+				partname = "production_b";
+			};
+		};
+	};
+};
+
+&{/chosen} {
+	rootdisk-emmc = <&emmc_rootfs>;
+	rootdisk-emmc-a = <&emmc_rootfs>;
+	rootdisk-emmc-b = <&emmc_rootfs_b>;
+};

--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-4e-sd.dtso
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Copyright (C) 2023 MediaTek Inc.
+ * Author: Frank Wunderlich <frank-w@public-files.de>
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	compatible = "bananapi,bpi-r4-pro-4e", "mediatek,mt7988a";
+};
+
+&{/soc/mmc@11230000} {
+	pinctrl-names = "default", "state_uhs";
+	pinctrl-0 = <&mmc0_pins_sdcard>;
+	pinctrl-1 = <&mmc0_pins_sdcard>;
+	cd-gpios = <&pio 12 GPIO_ACTIVE_LOW>;
+	bus-width = <4>;
+	max-frequency = <25000000>;
+	cap-sd-highspeed;
+	vmmc-supply = <&reg_3p3v>;
+	vqmmc-supply = <&reg_3p3v>;
+	no-mmc;
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	card@0 {
+		compatible = "mmc-card";
+		reg = <0>;
+
+		partitions {
+			compatible = "gpt-partitions";
+
+			block-partition-env {
+				partname = "ubootenv";
+				nvmem-layout {
+					compatible = "u-boot,env-layout";
+				};
+			};
+
+			sd_rootfs: block-partition-production {
+				partname = "production";
+			};
+		};
+	};
+};
+
+&{/chosen} {
+	rootdisk-sd = <&sd_rootfs>;
+};
