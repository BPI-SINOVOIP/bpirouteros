@@ -0,0 +1,9 @@
+#!/bin/sh
+# Enable the PHY preparation service and run it once on first deployment.
+#
+# rcS globs /etc/rc.d once when it starts, so the symlink this creates is not
+# picked up until the next boot. The explicit boot action supplies the same
+# ordering on the first boot without making runtime start destructive.
+/etc/init.d/bpirouter-as21xxx-fw enable
+/etc/init.d/bpirouter-as21xxx-fw boot
+exit 0
