arm64: dts: r4-pro: enable mxl862xx 2.5G switch (4x 2.5G) on gmac2

Stage 2B (+ fixes from real-machine bring-up): MxL86252 2.5G DSA switch on
gmac2 -> CPU port9 10GBASE-R (mxl862xx-8021q tag); 4x 2.5G = mxl_lan0..3. Own DSA
tree (dsa,member <1 0>) so it doesn't collide with the internal mt7530. Set
mdio_bus clock to 12.5 MHz (vendor 8X value) or the switch GPHY mmd reads
time out. The 10G LAN combo is added on upstream-numbered port13 by the next
board stage; this is the second XPCS anchor and does not share the CPU port9
XPCS instance.

Standalone forwarding through one MxL user port failed on the former vendor
stack. A clean-commit 2026-09-03 R4-Pro development image using the migrated
upstream stack passed an isolated mxl_lan3 test with 5/5 ICMP replies, clearing
that historical driver limitation on one board. 2.5-Gbps negotiation and formal
acceptance remain pending; bridge/VLAN operation is not the standalone evidence.

--- a/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-8x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-8x.dts
@@ -243,6 +243,90 @@
 		output-low;
 	};
 };
+&gmac2 {
+	phy-mode = "10gbase-r";
+	phy-connection-type = "10gbase-r";
+	status = "okay";
+
+	fixed-link {
+		speed = <10000>;
+		full-duplex;
+		pause;
+	};
+};
+
+&mdio_bus {
+	/* The MxL switch mailbox (c45 MMD30) and the AS21010P PHYs need a calmer
+	 * MDIO clock; match the vendor 8X dtsi 12.5 MHz. The SoC default is too
+	 * fast and the switch-internal GPHY mmd reads time out (-110). */
+	clock-frequency = <12500000>;
+
+	/* MaxLinear MxL86252 2.5G switch on gmac2 (10GBASE-R uplink, mxl862xx-8021q
+	 * tag). 4x 2.5G copper = mxl_lan0..3. The 10G LAN combo is added on
+	 * upstream-numbered switch port13 by the following board stage. */
+	switch16: switch@16 {
+		compatible = "maxlinear,mxl86252";
+		reg = <16>;
+		dsa,member = <1 0>;
+		/* 2.5G LAN ports. The driver is the OpenWrt upstream backport stack;
+		 * bridge, VLAN and legacy-firmware handling are kept in that single
+		 * lifecycle rather than a board-local vendor forward-port. */
+		status = "okay";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			mxl_port1: port@1 {
+				reg = <1>;
+				label = "mxl_lan0";
+				phy-handle = <&switchphy0>;
+				phy-mode = "internal";
+			};
+			mxl_port2: port@2 {
+				reg = <2>;
+				label = "mxl_lan1";
+				phy-handle = <&switchphy1>;
+				phy-mode = "internal";
+			};
+			mxl_port3: port@3 {
+				reg = <3>;
+				label = "mxl_lan2";
+				phy-handle = <&switchphy2>;
+				phy-mode = "internal";
+			};
+			mxl_port4: port@4 {
+				reg = <4>;
+				label = "mxl_lan3";
+				phy-handle = <&switchphy3>;
+				phy-mode = "internal";
+			};
+			mxl_cpu: port@9 {
+				reg = <9>;
+				label = "cpu";
+				phy-mode = "10gbase-r";
+				ethernet = <&gmac2>;
+				dsa-tag-protocol = "mxl862xx-8021q";
+
+				fixed-link {
+					speed = <10000>;
+					full-duplex;
+				};
+			};
+		};
+
+		mdio {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			switchphy0: switchphy@0 { reg = <0>; };
+			switchphy1: switchphy@1 { reg = <1>; };
+			switchphy2: switchphy@2 { reg = <2>; };
+			switchphy3: switchphy@3 { reg = <3>; };
+		};
+	};
+};
+
 &i2c2 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&i2c2_1_pins>;
