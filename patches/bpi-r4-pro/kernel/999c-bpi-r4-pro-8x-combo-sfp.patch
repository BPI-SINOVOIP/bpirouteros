 		bootargs = "console=ttyS0,115200n1 pci=pcie_bus_perf ubi.block=0,fit root=/dev/fit0";
 		rootdisk-spim-nand = <&ubi_rootfs>;
+		/* Boot-time combo media. The copper default is the whole board for
+		 * environments that apply no media overlay; the SFP overlays replace
+		 * the value they select. */
+		bpirouter,wan-media = "copper";
+		bpirouter,lan-media = "copper";
 	};
 
 	fan: pwm-fan {
@@ -97,6 +102,28 @@
 			default-state = "off";
 		};
 	};
+
+	/* CM17 SFP2: the WAN combo cage on MT7988 USXGMII_1 (GPIO3 high). */
+	sfp_wan: sfp-wan {
+		compatible = "sff,sfp";
+		i2c-bus = <&sfp_wan_i2c>;
+		mod-def0-gpios = <&pio 1 GPIO_ACTIVE_LOW>;
+		los-gpios = <&pio 2 GPIO_ACTIVE_HIGH>;
+		tx-disable-gpios = <&pio 0 GPIO_ACTIVE_HIGH>;
+		maximum-power-milliwatt = <3000>;
+		status = "disabled";
+	};
+
+	/* CM17 SFP1: the LAN combo cage on MxL SerDes port 13 (GPIO54 low). */
+	sfp_lan: sfp-lan {
+		compatible = "sff,sfp";
+		i2c-bus = <&sfp_lan_i2c>;
+		mod-def0-gpios = <&pio 69 GPIO_ACTIVE_LOW>;
+		los-gpios = <&pio 70 GPIO_ACTIVE_HIGH>;
+		tx-disable-gpios = <&pio 21 GPIO_ACTIVE_HIGH>;
+		maximum-power-milliwatt = <3000>;
+		status = "disabled";
+	};
 };
 
 &serial0 {
@@ -324,6 +351,24 @@
 	status = "okay";
 };
 
+&eth {
+	/* The WAN combo SFP attachment of MAC 1. An overlay cannot delete the
+	 * copper phy-handle above, so the SFP form is a second node for the same
