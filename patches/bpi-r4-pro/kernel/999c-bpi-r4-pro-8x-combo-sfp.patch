 	};
+
+	/* CM17: GPIO54 low routes the MxL SerDes to the LAN SFP cage. */
+	lan_combo_sfp_hog: lan_combo_sfp_hog {
+		gpio-hog;
+		gpios = <54 GPIO_ACTIVE_HIGH>;
+		output-low;
+		status = "disabled";
+	};
 };
 &gmac2 {
 	phy-mode = "10gbase-r";
@@ -431,6 +492,18 @@
