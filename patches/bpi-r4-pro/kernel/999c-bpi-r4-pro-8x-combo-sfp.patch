--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-8x-lan-sfp.dtso
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * BPI-R4 Pro 8X: run the LAN combo (mxl_lan4) on its SFP+ cage instead
+ * of the AS21010P copper PHY. U-Boot applies this overlay when
+ * r4pro_8x_lan_media=sfp; without it the base DTB keeps copper.
+ */
+
+/dts-v1/;
+/plugin/;
+
+/ {
+	compatible = "bananapi,bpi-r4-pro-8x", "mediatek,mt7988a";
+};
+
+&{/chosen} {
+	bpirouter,lan-media = "sfp";
+};
+
+&mxl_port13 {
+	status = "disabled";
+};
+
+&mxl_port13_sfp {
+	status = "okay";
+};
+
+&sfp_lan {
+	status = "okay";
+};
+
+&lan_combo_copper_hog {
+	status = "disabled";
+};
+
+&lan_combo_sfp_hog {
+	status = "okay";
+};
--- /dev/null
