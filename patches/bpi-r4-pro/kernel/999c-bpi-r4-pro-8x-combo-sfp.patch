+	 * registered by MAC id, so either form is eth1. */
+	gmac1_sfp: mac-sfp@1 {
+		compatible = "mediatek,eth-mac";
+		reg = <1>;
+		pcs-handle = <&sgmiipcs1>, <&usxgmiisys1>;
+		phys = <&xfi_tphy1>;
+		phy-mode = "10gbase-r";
+		phy-connection-type = "10gbase-r";
+		managed = "in-band-status";
+		sfp = <&sfp_wan>;
+		status = "disabled";
+	};
+};
+
 &mdio_bus {
 	/* AS21010P 10G WAN PHY at 0x1c. No reset-gpios here: phylib can't cleanly
 	 * reset this firmware PHY, so it is reset in u-boot (board_late_init, see
@@ -352,18 +397,34 @@
 		};
 	};
 
